# ==============================================================================
# PriceNest — Git Ignore Configuration
# ==============================================================================

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Environment & Secret Files ---
# Never commit real credentials or secrets
.env
.env.*
!.env.example
*.env.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Python & Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Next.js Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
frontend/.next/
.next/
out/
build/
dist/
.turbo

# Next.js telemetry
.next/telemetry/

# --- Datasets & Data Storage ---
# Raw and processed datasets are kept local and excluded from version control
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
*.csv
*.tsv
*.xlsx
*.parquet
*.feather
*.h5
*.sqlite3
*.db
!scripts/**/*.csv

# --- Machine Learning Artifacts & Checkpoints ---
# Trained models, scalers, encoders, and serialized pipelines
ml/models/*.joblib
ml/models/*.pkl
ml/models/*.pickle
ml/models/*.onnx
ml/models/*.pt
ml/models/*.pth
ml/artifacts/*
!ml/artifacts/.gitkeep
!ml/models/.gitkeep
*.joblib
*.pkl
*.pickle
*.onnx

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Log Files ---
logs/
*.log
