# ==============================================================================
# PriceNest — Frontend Environment Variables Template
# ==============================================================================
# Copy this file to `frontend/.env.local` for local development.
# DO NOT commit real secrets or `.env.local` to version control.

# Backend API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Application Metadata
NEXT_PUBLIC_APP_NAME=PriceNest
NEXT_PUBLIC_APP_DESCRIPTION="Residential Real-Estate Price Prediction for Pune, India"

# Optional Analytics / Sentry (Leave blank during local dev)
NEXT_PUBLIC_ANALYTICS_ID=
