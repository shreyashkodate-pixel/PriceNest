# ==============================================================================
# PriceNest — Backend Environment Variables Template
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# DO NOT commit the actual `.env` file containing secrets to version control.

# Application Configuration
APP_NAME=PriceNest-Backend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL on Supabase)
# For local dev via Supabase pooler or direct connection:
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres
# Synchronous URL for Alembic migrations:
SYNC_DATABASE_URL=postgresql://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres

# Machine Learning Artifacts
MODEL_ARTIFACTS_DIR=../ml/models
ACTIVE_MODEL_VERSION=v1.0.0
ACTIVE_MODEL_FILENAME=pricenest_pune_model_v1.0.0.joblib

# Security & CORS
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-for-local-development
ACCESS_TOKEN_EXPIRE_MINUTES=1440
